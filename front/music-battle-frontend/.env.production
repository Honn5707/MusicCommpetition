# 배포(production) 빌드용 환경변수 — 공개돼도 되는 값만 둔다.
# (클라이언트 시크릿 GOCSPX-... 같은 비밀값은 절대 여기 두지 말 것 — 백엔드 전용)
# vite build 시 .env.local 보다 우선 적용된다.

# YouTube Data API v3 키(공개). 곡 검색 탭 활성화.
VITE_YOUTUBE_API_KEY=AIzaSyCmpK2o9NyHVXJs5OWKjY6t9tS5RqhcG0c

# reCAPTCHA v2 사이트 키(공개).
VITE_RECAPTCHA_SITE_KEY=6LfzR4otAAAAADuLQYi9dKs7Z-hSPGjYrvASLMq7

# ── 구글 OAuth 로그인 ──────────────────────────────────
# 구글 클라이언트 ID(공개 값).
VITE_GOOGLE_CLIENT_ID=928248154948-cifoc9uggihvb11d0gt2qo6lrli9i3et.apps.googleusercontent.com
# 구글 리다이렉트 URI = "프론트" 콜백 페이지(/oauth/callback). 백엔드 경로(/api/...) 금지.
# 구글 콘솔 "승인된 리디렉션 URI"와 정확히 동일해야 한다.
VITE_GOOGLE_REDIRECT_URI=http://musictest.kro.kr/oauth/callback

# ── 실시간 댓글(STOMP) ─────────────────────────────────
# 비워두면 현재 접속 호스트 기준으로 ws(s)://<host>/ws 를 자동 생성한다.
# (배포는 프론트/백엔드가 같은 도메인이라 자동값으로 충분. http면 ws://, https면 wss://)
VITE_WS_URL=
