# YouTube Data API v3 키를 넣으면 곡 등록 시 '검색' 탭이 활성화된다.
# 미설정이면 자동으로 기존 'YouTube 링크 붙여넣기' 방식으로 폴백한다.
# 사용하려면 이 파일을 .env(또는 .env.local)로 복사하고 값을 채운 뒤 dev 서버를 재시작.
VITE_YOUTUBE_API_KEY=AIzaSyCmpK2o9NyHVXJs5OWKjY6t9tS5RqhcG0c

# 회원가입 폼의 reCAPTCHA v2 체크박스 사이트 키. 백엔드 recaptcha.secret(비밀 키)과 짝을 이룬다.
VITE_RECAPTCHA_SITE_KEY=6LfzR4otAAAAADuLQYi9dKs7Z-hSPGjYrvASLMq7

# ── 구글 OAuth 로그인 ──────────────────────────────────
# 구글 클라이언트 ID(공개돼도 되는 값). 설정하면 "Google로 로그인" 버튼이 동작한다.
# ※ 클라이언트 시크릿(GOCSPX-...)은 프론트에 두지 않는다 — 백엔드 전용.
VITE_GOOGLE_CLIENT_ID=
# 구글 리다이렉트 URI = "프론트" 콜백 페이지(/oauth/callback). 백엔드 경로(/api/...) 금지.
# 비워두면 현재 출처 기준 /oauth/callback 을 쓴다. 구글 콘솔 등록 URI와 정확히 동일해야 한다.
# 로컬 예시:   http://localhost:5173/oauth/callback
# 배포 예시:   http://musictest.kro.kr/oauth/callback
VITE_GOOGLE_REDIRECT_URI=

# ── 실시간 댓글(STOMP) ─────────────────────────────────
# 웹소켓 브로커 URL. 비워두면 현재 호스트 기준 ws(s)://<host>/ws 를 자동 생성한다.
# 로컬은 백엔드 포트가 달라 지정 필요: ws://localhost:8080/ws
VITE_WS_URL=
